# Discord
DISCORD_BOT_TOKEN=
ETHUSD_CHANNEL_ID=
SOLUSD_CHANNEL_ID=
BTCUSD_CHANNEL_ID=

# Database & Logging
DATABASE_PATH=./alerts.db
LOG_LEVEL=info

# Delta Public WS
DELTA_WS_URL=wss://public-socket.india.delta.exchange

# --- Trade Management (Delta Exchange India) ---
# Auth (required if TRADE_MANAGEMENT_ENABLED=true)
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_API_BASE_URL=https://api.india.delta.exchange

# Gates (all default safe/disabled)
TRADE_MANAGEMENT_ENABLED=false
TRADE_DEMO_MODE=false
# Live stop placement gate (default false)
TRADE_STOP_LOSS_ENABLED=false
# Live close execution gate (default false)
TRADE_CLOSE_ENABLED=false

# Stop/monitoring
TRADE_STOP_LOSS_OFFSET=100
TRADE_POLL_INTERVAL_MS=30000

# Dashboard (dedicated channel required when trade mgmt enabled)
TRADE_DISCORD_CHANNEL_ID=
TRADE_DASHBOARD_THROTTLE_MS=5000
