# Discord Alert Bot - environment configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# Placeholders below are examples only; do not use them in production.

# --- Discord (required for any Discord functionality) ---
# Bot token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=

# One dedicated channel per symbol. Each must be a Discord channel ID and all
# three must be unique. Alerts and /alert commands only work in these channels.
ETHUSD_CHANNEL_ID=
SOLUSD_CHANNEL_ID=
BTCUSD_CHANNEL_ID=

# --- Database & Logging ---
# SQLite file path. Created automatically if missing.
DATABASE_PATH=./alerts.db
LOG_LEVEL=info

# --- Delta Exchange public WebSocket (price alerts) ---
DELTA_WS_URL=wss://public-socket.india.delta.exchange
# Reconnect backoff start (ms). Default 2000.
DELTA_RECONNECT_INTERVAL_MS=2000
# Reconnect backoff cap (ms). Default 60000.
DELTA_MAX_RECONNECT_INTERVAL_MS=60000

# NOTE: monitored symbols are hardcoded to ETHUSD, SOLUSD, BTCUSD in
# src/config/index.ts. DELTA_SYMBOLS is not read by the application.

# --- Trade Management (Delta Exchange India) ---
# All trade-management features are OFF by default. Enable gates individually
# and deliberately; see docs/CONFIGURATION.md and docs/TRADE_MANAGEMENT.md.

# Master switch. When true, DELTA_API_KEY and DELTA_API_SECRET are required
# and TRADE_DISCORD_CHANNEL_ID must be set. Default: false.
TRADE_MANAGEMENT_ENABLED=false

# Demo/dry-run mode. When true, stop placement and close execution do not
# submit orders to the exchange. Default: false.
TRADE_DEMO_MODE=false

# Authenticated Delta REST API credentials. Required only when
# TRADE_MANAGEMENT_ENABLED=true.
DELTA_API_KEY=
DELTA_API_SECRET=
# Delta Exchange India REST base URL. Default: https://api.india.delta.exchange
DELTA_API_BASE_URL=https://api.india.delta.exchange

# --- Independent safety gates (each defaults to false/disabled) ---
# Trade management must be enabled for either gate to have any effect.
# Live stop placement (reduce-only stop-market orders). Default: false.
TRADE_STOP_LOSS_ENABLED=false
# Live close execution (reduce-only market close orders). Default: false.
TRADE_CLOSE_ENABLED=false

# --- Stop loss & monitoring ---
# Offset from entry price for stop calculation (quote currency units).
# Must be positive when trade management is enabled. Default: 100.
TRADE_STOP_LOSS_OFFSET=100
# Position poll interval in milliseconds. Must be >= 1000 when trade
# management is enabled. Default: 30000 (30s).
TRADE_POLL_INTERVAL_MS=30000

# --- Trade dashboard (dedicated channel required when trade mgmt enabled) ---
# Separate Discord channel ID from the ETHUSD/SOLUSD/BTCUSD alert channels.
# No fallback to alert channels. Required when TRADE_MANAGEMENT_ENABLED=true.
TRADE_DISCORD_CHANNEL_ID=
# Dashboard refresh throttle in milliseconds. Must be >= 1000 when trade
# management is enabled. Effective interval is max(this, 5000). Default: 5000.
TRADE_DASHBOARD_THROTTLE_MS=5000
